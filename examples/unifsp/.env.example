# UniFSP（统一文件服务平台）测试环境变量
# 复制本文件为 .env 并填写实际值（.env 已被 .gitignore 忽略）

# API 根地址（可带 /index，debugtalk.py 会自动去掉）
UNIFSP_BASE_URL=http://unifsp-test.example.com/index

# OAuth2 客户端凭据（client_id 同时用作应用目录 /{client_id}/）
UNIFSP_CLIENT_ID=your_client_id_here
UNIFSP_CLIENT_SECRET=your_client_secret_here
